<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aplicacion">
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Infraestructura">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- 7.x para ir alineado con Microsoft.AspNetCore.Authentication.JwtBearer 8.0.x -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.6.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Reportes">
    <!-- QuestPDF: obligatorio por el enunciado. Licencia Community (MIT) para
         organizaciones con ingresos menores a un millon de dolares. -->
    <PackageVersion Include="QuestPDF" Version="2024.12.3" />
    <!-- ClosedXML: eleccion propia para Excel. Licencia MIT. -->
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- NSubstitute: dobles de prueba para los puertos. Licencia BSD.
         Las aserciones son las de xUnit a proposito: FluentAssertions dejo de ser
         libre en su version 8 y no se quiso atar el proyecto a una licencia comercial. -->
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
</Project>
