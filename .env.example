# Copiar a .env y levantar con: docker compose up -d --build
# Los valores por defecto funcionan tal cual; son credenciales de evaluacion local.

# ---- Base de datos ----
POSTGRES_DB=scrumsoft
POSTGRES_USER=scrumsoft
POSTGRES_PASSWORD=scrumsoft

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
# Minimo 32 caracteres, o la api no arranca.
JWT_CLAVE=clave-de-evaluacion-local-cambiar-en-produccion-2026
JWT_EMISOR=ScrumSoft
JWT_AUDIENCIA=ScrumSoftClientes
JWT_MINUTOS_DE_VIGENCIA=60
CORS_ORIGEN=http://localhost:4200

# ---- Puertos publicados ----
# Aplicacion en 8086, Swagger en 8085. El 4200 se deja libre a proposito: es el
# puerto por defecto de ng serve y chocaria con cualquier Angular corriendo en la
# maquina; un choque de puertos aborta el docker compose up entero.
WEB_PUERTO=8086
API_PUERTO=8085
