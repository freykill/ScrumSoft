root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# Las migraciones las escribe EF Core, no nosotros. Se regeneran, asi que
# corregirlas a mano no sirve de nada: se marcan como codigo generado y los
# analizadores las dejan en paz.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
